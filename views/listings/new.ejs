<% title = 'StayNEST | New' %>
<% layout('./layouts/boilerplate') %>

<body>

  <div class="row">
    <div class="col col-lg-10 offset-md-2">
      <form method='post' action="/listings/create" class="new-form">
        <h3>Create a New Listing!</h3><br>
        <div class="row row-cols-md-2 row-cols-1">
          <div class="col col-md-4">
            <label style="display: block;" class="form-label mb-2">
              Title: &nbsp;<input spellcheck="false" spellcheck="false" type="text" name="listing[title]" placeholder="enter title" class="form-control">
            </label>
          </div>

          <div class="col col-md-4">
            <label style="display: block;" class="form-label mb-2">
              Price:<input spellcheck="false" class="form-control" type="number" name="listing[price]" placeholder="enter price (in ₹/night)">
            </label>
          </div>
        </div>

        <div class="row">
          <label class="form-label mb-2 col-md-8 col">
            Description:
            <textarea spellcheck="false" class="form-control" name="listing[description]" placeholder="enter description"></textarea>
          </label>
        </div>

        <div class="row">
          <label class="form-label mb-2 col-md-8 col">
            Image Link:
            <input spellcheck="false" type="text" name="listing[image]" class="form-control" placeholder="enter image URL/Link">
          </label>
        </div>

        <div class="row row-cols-md-2 row-cols-1">
          <label style="display: block;" class="form-label mb-2 col col-md-4">
            Location: &nbsp;<input spellcheck="false" class="form-control" type="text" name="listing[location]" placeholder="enter location">
          </label>

          <label style="display: block;" class="form-label mb-2 col col-md-4">
            Country: &nbsp;<input spellcheck="false" class="form-control" type="text" name="listing[country]" placeholder="enter country">
          </label>
        </div>

        <br>

        <button class="btn">Create</button>
      </form>
    </div>

  </div>

</body>