<% title = `StayNEST | ${listing.title}` %>
<% layout('./layouts/boilerplate') %>

<body>
  <h3>Listing Details:</h3>
  <ul>
    <li><%= listing.title %></li>
    <li><%= listing.description %></li>
    <li>&#8377;<%= listing.price.toLocaleString('en-IN') %></li>
    <li><%= listing.location %></li>
    <li><%= listing.country %></li>
  </ul>

  <a href="/listings/edit/<%= listing._id %>">Edit</a>
  &nbsp;&nbsp;
  <form style="display: inline;" method="POST" action="/listings/delete/<%= listing._id %>?_method=DELETE">
    <button>Delete</button>
  </form>
</body>