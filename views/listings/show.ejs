<% title = `StayNEST | ${listing.title}` %>
<% layout('./layouts/boilerplate') %>

<body>
  <div class="show row offset-md-1">
    <div class="col-md-9">
      <img style="border-radius: 1.95rem; width: 85%;" src="<%= listing.image %>" alt="listing">
      <h3 class="mt-3">Listing Details:</h3>
      <p class="my-3">
        <span style="display: inline-block;" class="mb-1"><b><%= listing.title %></b></span>
        <% if (listing.description) { %>
        <br><span style="display: inline-block;" class="mb-1"><%= listing.description %></span>
        <% } %>
        <br>&#8377;<%= listing.price.toLocaleString('en-IN') %>
        <br><%= listing.location %>
        <br><%= listing.country %>
      </p>

      <a class="btn" href="/listings/edit/<%= listing._id %>">Edit</a>
      &nbsp;&nbsp;
      <form style="display: inline;" method="POST" action="/listings/delete/<%= listing._id %>?_method=DELETE">
        <button style="background-color: #1a0606 !important;" class="btn">Delete</button>
      </form>

      <!-- Dialog Box -->
      <button type="button" class="btn btn-link" data-bs-toggle="modal" data-bs-target="#staticBackdrop">Write a review</button>

      <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="staticBackdropLabel">Leave Feedback</h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form action="/listings/<%= listing.id %>/review" method="post">
                <label class="form-label" for="rating">
                  <h5>Rating</h5>
                </label>
                <input id="rating" name="review[rating]" type="range" min="1" max="5" class="form-range">

                <label class="form-label" for="comment">Review</label>
                <textarea class="form-control" name="review[comment]" id="comment" placeholder="Tell us about your experience..." rows="5"></textarea>

                <div class="modal-footer">
                  <button type="submit" class="btn">Submit</button>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>
    </div>

  </div>


</body>