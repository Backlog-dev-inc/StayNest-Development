<% title = 'StayNEST' %>
<% layout('./layouts/boilerplate') %>

<body>
  <h3>All Listings!</h3>
  <div class="card-container row row-cols-sm-1 row-cols-md-3 justify-content-center">
    <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="card">
      <img src="<%= listing.image %>" class="card-img-top" alt="listing">
      <div class="card-body">
        <p class="card-title"><b><%=listing.title%></b></p>
        <p class="card-text">&#8377;<%= listing.price.toLocaleString('en-IN')%>/night</p>
      </div>
    </a>
    <% } %>
  </div>

</body>