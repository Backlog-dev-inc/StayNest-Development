<% title = `Edit | ${listing.title}` %>
<% layout('./layouts/boilerplate') %>

<body>
  <h3><%= listing._id %></h3>

  <form method='POST' action="/listings/update/<%= listing._id %>?_method=PUT" novalidate>
    <label style="display: block;">
      Title: &nbsp;<input type="text" name="listing[title]" placeholder="enter title" value="<%= listing.title %>">
    </label><br>

    <label style="display: block;">
      Description: <br><br>
      <textarea name="listing[description]" placeholder="enter description"><%= listing.description %></textarea>
    </label><br>

    <label style="display: block;">
      Price: &nbsp;&#8377;<input type="number" name="listing[price]" placeholder="enter price" value="<%= listing.price %>">
    </label><br>

    <label style="display: block;">
      Location: &nbsp;<input type="text" name="listing[location]" placeholder="enter location" value="<%= listing.location %>">
    </label><br>

    <label style="display: block;">
      Country: &nbsp;<input type="text" name="listing[country]" placeholder="enter country" value="<%= listing.country %>">
    </label><br>

    <button>Edit</button>
  </form>
</body>

</html>