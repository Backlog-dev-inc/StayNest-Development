<% title = `Edit | ${listing.title}` %>
<% layout('./layouts/boilerplate') %>

<body>

  <div class="row">
    <div class="col col-lg-10 offset-md-2">
      <form method='post' action="/listings/update/<%= listing._id %>?_method=PUT" class="new-form">
        <h3>Edit Listing: <%= listing._id %></h3><br>
        <div class="row row-cols-md-2 row-cols-1">
          <div class="col col-md-4">
            <label style="display: block;" class="form-label mb-2">
              Title: &nbsp;<input type="text" name="listing[title]" placeholder="enter title" class="form-control" value="<%= listing.title %>">
            </label>
          </div>

          <div class="col col-md-4">
            <label style="display: block;" class="form-label mb-2">
              Price:<input class="form-control" type="number" name="listing[price]" placeholder="enter price (in ₹/night)" value="<%= listing.price %>">
            </label>
          </div>
        </div>

        <div class="row">
          <label style="display: block;" class="form-label mb-2 col-md-8 col">
            Description:
            <textarea class="form-control" name="listing[description]" placeholder="enter description"><%= listing.description %></textarea>
          </label>
        </div>

        <div class="row">
          <label class="form-label mb-2 col-md-8 col">
            Image Link:
            <input type="text" name="listing[image]" class="form-control" placeholder="enter image URL/Link" value="<%= listing.image %>">
          </label>
        </div>

        <div class="row row-cols-md-2 row-cols-1">
          <label style="display: block;" class="form-label mb-2 col col-md-4">
            Location: &nbsp;<input class="form-control" type="text" name="listing[location]" placeholder="enter location" value="<%= listing.location %>">
          </label>

          <label style="display: block;" class="form-label mb-2 col col-md-4">
            Country: &nbsp;<input class="form-control" type="text" name="listing[country]" placeholder="enter country" value="<%= listing.country %>">
          </label>
        </div>

        <br>

        <button class="btn">Edit</button>
      </form>
    </div>

  </div>

</body>

</html>